{
  "name": "ya-chat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke-chat-store.ts && tsx scripts/smoke-settings-models.ts && tsx scripts/smoke-send.ts && tsx scripts/smoke-tools.ts && tsx scripts/smoke-panels.ts",
    "test:parity": "tsx scripts/render-parity.ts",
    "test:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live-parity.ps1",
    "test": "npm run test:smoke && npm run test:parity"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.2.3"
  }
}
